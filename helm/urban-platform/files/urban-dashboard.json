{
  "title": "Urban Platform — Service Health",
  "uid": "urban-health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "tags": ["urban"],
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Pod CPU (cores)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{pod}}",
        "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"urban\",container!=\"\"}[5m]))" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Pod memory (working set)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "refId": "A", "legendFormat": "{{pod}}",
        "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"urban\",container!=\"\"})" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Request rate by service (req/s)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{job}}",
        "expr": "sum by (job) (rate(http_requests_total{namespace=\"urban\"}[5m]))" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "HTTP 5xx error ratio",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 } },
      "targets": [{ "refId": "A", "legendFormat": "{{job}}",
        "expr": "sum by (job) (rate(http_requests_total{namespace=\"urban\",status=\"5xx\"}[5m])) / sum by (job) (rate(http_requests_total{namespace=\"urban\"}[5m]))" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "p95 latency (s)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "refId": "A", "legendFormat": "{{job}}",
        "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_seconds_bucket{namespace=\"urban\"}[5m])))" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Ingestion throughput (rows/min by city)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "legendFormat": "{{city}}",
        "expr": "sum by (city) (rate(processor_records_ingested_total{namespace=\"urban\"}[10m])) * 60" }]
    },
    {
      "id": 7, "type": "stat", "title": "Seconds since last ingest",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 1800 }, { "color": "red", "value": 2700 } ] } } },
      "targets": [{ "refId": "A", "expr": "time() - max(processor_last_ingest_timestamp_seconds{namespace=\"urban\"})" }]
    },
    {
      "id": 8, "type": "stat", "title": "Pods not ready",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [{ "refId": "A", "expr": "sum(kube_pod_status_ready{namespace=\"urban\",condition=\"false\"}) or vector(0)" }]
    }
  ]
}
