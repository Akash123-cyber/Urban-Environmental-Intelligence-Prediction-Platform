#!/bin/bash
set -euxo pipefail
exec > >(tee /var/log/user-data.log) 2>&1

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get purge -y snapd || true
rm -rf /var/cache/snapd /var/lib/snapd /snap || true
apt-get install -y curl jq unzip ca-certificates docker.io
systemctl enable --now docker
usermod -aG docker ubuntu

# 1. Configure 2 GB Swap (essential guard against OOM on 4 GB node)
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# 2. Get Private IP via IMDSv2 for TLS SANs
TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
PRIV_IP=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)

# 3. Install k3s with Docker CRI (eliminates duplicate containerd storage on 16GB disk)
curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="server \
  --docker \
  --disable traefik --disable servicelb \
  --write-kubeconfig-mode 644 \
  --tls-san ${public_ip} --tls-san $PRIV_IP \
  --kubelet-arg=fail-swap-on=false \
  --kubelet-arg=image-gc-high-threshold=95 \
  --kubelet-arg=image-gc-low-threshold=90 \
  --kubelet-arg=eviction-hard=imagefs.available<3%,nodefs.available<3%" sh -

# 4. Wait for k3s cluster ready
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
echo 'export KUBECONFIG=/etc/rancher/k3s/k3s.yaml' >> /home/ubuntu/.bashrc

until kubectl get nodes 2>/dev/null | grep -q " Ready"; do
  sleep 3
done

# 5. Populate Auto-Deploying Manifests for k3s HelmController
MANIFESTS_DIR=/var/lib/rancher/k3s/server/manifests
mkdir -p "$MANIFESTS_DIR"

# 5.1 Ingress-Nginx Controller (HostPort 80/443)
cat <<'EOF' > "$MANIFESTS_DIR/01-ingress-nginx.yaml"
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: ingress-nginx
  namespace: kube-system
spec:
  chart: ingress-nginx
  repo: https://kubernetes.github.io/ingress-nginx
  targetNamespace: ingress-nginx
  createNamespace: true
  valuesContent: |-
    controller:
      hostPort:
        enabled: true
      service:
        type: ClusterIP
      metrics:
        enabled: true
      resources:
        requests:
          cpu: 50m
          memory: 128Mi
EOF

# 5.2 Application Namespace, Secrets & ConfigMap
cat <<EOF > "$MANIFESTS_DIR/02-urban-core.yaml"
apiVersion: v1
kind: Namespace
metadata:
  name: urban
---
apiVersion: v1
kind: Secret
metadata:
  name: db-credentials
  namespace: urban
type: Opaque
stringData:
  POSTGRES_USER: "urban"
  POSTGRES_DB: "urban"
  POSTGRES_PASSWORD: "${postgres_password}"
  DATABASE_URL: "postgresql://urban:${postgres_password}@postgres:5432/urban"
---
apiVersion: v1
kind: Secret
metadata:
  name: api-auth-secret
  namespace: urban
type: Opaque
stringData:
  JWT_SECRET: "${jwt_secret}"
  ADMIN_EMAIL: "${admin_email}"
  ADMIN_PASSWORD: "${admin_password}"
---
apiVersion: v1
kind: Secret
metadata:
  name: collector-secret
  namespace: urban
type: Opaque
stringData:
  OPENAQ_API_KEY: "${openaq_api_key}"
---
apiVersion: v1
kind: Secret
metadata:
  name: urban-secrets
  namespace: urban
type: Opaque
stringData:
  POSTGRES_USER: "urban"
  POSTGRES_DB: "urban"
  POSTGRES_PASSWORD: "${postgres_password}"
  DATABASE_URL: "postgresql://urban:${postgres_password}@postgres:5432/urban"
  JWT_SECRET: "${jwt_secret}"
  ADMIN_EMAIL: "${admin_email}"
  ADMIN_PASSWORD: "${admin_password}"
  OPENAQ_API_KEY: "${openaq_api_key}"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: urban-config
  namespace: urban
data:
  AWS_REGION: "${region}"
  S3_RAW_BUCKET: "${raw_bucket}"
  S3_PROCESSED_BUCKET: "${processed_bucket}"
  S3_MODEL_BUCKET: "${model_bucket}"
  MODEL_S3_PREFIX: "models/latest/"
  USE_PRETRAINED: "true"
  LIVE_LOOKBACK_HOURS: "2"
  PROCESSOR_URL: "http://data-processor:5000"
  ANALYTICS_URL: "http://analytics-service:5001"
  POLL_INTERVAL_SECONDS: "900"
  ANALYTICS_INTERVAL_SECONDS: "1800"
  LOG_LEVEL: "INFO"
EOF

# 5.3 PostgreSQL Database
cat <<'EOF' > "$MANIFESTS_DIR/03-postgres.yaml"
apiVersion: v1
kind: ConfigMap
metadata:
  name: postgres-init
  namespace: urban
data:
  init.sql: |
    CREATE EXTENSION IF NOT EXISTS pgcrypto;
    CREATE TABLE IF NOT EXISTS cities (
      id SERIAL PRIMARY KEY,
      slug TEXT NOT NULL UNIQUE,
      name TEXT NOT NULL,
      state TEXT NOT NULL DEFAULT '',
      country TEXT NOT NULL DEFAULT 'India',
      latitude DOUBLE PRECISION NOT NULL,
      longitude DOUBLE PRECISION NOT NULL,
      created_at TIMESTAMPTZ NOT NULL DEFAULT now()
    );
    CREATE TABLE IF NOT EXISTS air_quality_data (
      id BIGSERIAL PRIMARY KEY,
      city_id INT NOT NULL REFERENCES cities(id) ON DELETE CASCADE,
      observed_at TIMESTAMPTZ NOT NULL,
      pm25 DOUBLE PRECISION, pm10 DOUBLE PRECISION, no2 DOUBLE PRECISION,
      o3 DOUBLE PRECISION, co DOUBLE PRECISION, so2 DOUBLE PRECISION,
      aqi INT, is_anomaly BOOLEAN NOT NULL DEFAULT FALSE,
      source TEXT NOT NULL DEFAULT 'open-meteo',
      UNIQUE (city_id, observed_at)
    );
    CREATE INDEX IF NOT EXISTS idx_aq_city_time ON air_quality_data (city_id, observed_at DESC);
    CREATE TABLE IF NOT EXISTS weather_data (
      id BIGSERIAL PRIMARY KEY,
      city_id INT NOT NULL REFERENCES cities(id) ON DELETE CASCADE,
      observed_at TIMESTAMPTZ NOT NULL,
      temperature DOUBLE PRECISION, humidity DOUBLE PRECISION, wind_speed DOUBLE PRECISION,
      UNIQUE (city_id, observed_at)
    );
    CREATE INDEX IF NOT EXISTS idx_wx_city_time ON weather_data (city_id, observed_at DESC);
    CREATE TABLE IF NOT EXISTS predictions (
      id BIGSERIAL PRIMARY KEY,
      city_id INT NOT NULL REFERENCES cities(id) ON DELETE CASCADE,
      generated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
      target_time TIMESTAMPTZ NOT NULL,
      predicted_pm25 DOUBLE PRECISION, predicted_pm10 DOUBLE PRECISION,
      model_version TEXT, based_on TIMESTAMPTZ,
      UNIQUE (city_id, target_time)
    );
    CREATE TABLE IF NOT EXISTS alerts (
      id BIGSERIAL PRIMARY KEY,
      city_id INT NOT NULL REFERENCES cities(id) ON DELETE CASCADE,
      type TEXT NOT NULL, severity TEXT NOT NULL DEFAULT 'warning',
      message TEXT NOT NULL, created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
      resolved_at TIMESTAMPTZ
    );
    CREATE TABLE IF NOT EXISTS users (
      id SERIAL PRIMARY KEY, email TEXT NOT NULL UNIQUE,
      password_hash TEXT NOT NULL, role TEXT NOT NULL DEFAULT 'user',
      created_at TIMESTAMPTZ NOT NULL DEFAULT now()
    );
    INSERT INTO cities (slug, name, state, country, latitude, longitude) VALUES
      ('delhi', 'Delhi', 'Delhi', 'India', 28.6139, 77.2090),
      ('mumbai', 'Mumbai', 'Maharashtra', 'India', 19.0760, 72.8777),
      ('kolkata', 'Kolkata', 'West Bengal', 'India', 22.5726, 88.3639),
      ('chennai', 'Chennai', 'Tamil Nadu', 'India', 13.0827, 80.2707),
      ('bengaluru', 'Bengaluru', 'Karnataka', 'India', 12.9716, 77.5946)
    ON CONFLICT (slug) DO NOTHING;
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: urban
spec:
  ports:
    - { name: pg, port: 5432, targetPort: 5432 }
  selector:
    app: postgres
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: postgres
  namespace: urban
spec:
  serviceName: postgres
  replicas: 1
  selector:
    matchLabels: { app: postgres }
  template:
    metadata:
      labels: { app: postgres }
    spec:
      securityContext:
        fsGroup: 999
      containers:
        - name: postgres
          image: postgres:16-alpine
          ports:
            - { name: pg, containerPort: 5432 }
          env:
            - { name: POSTGRES_USER, value: urban }
            - { name: POSTGRES_DB, value: urban }
            - name: POSTGRES_PASSWORD
              valueFrom: { secretKeyRef: { name: db-credentials, key: POSTGRES_PASSWORD } }
            - { name: PGDATA, value: /var/lib/postgresql/data/pgdata }
          readinessProbe:
            exec: { command: ["pg_isready", "-U", "urban", "-d", "urban"] }
            initialDelaySeconds: 5
            periodSeconds: 5
          resources:
            requests: { cpu: 100m, memory: 256Mi }
            limits: { cpu: 500m, memory: 512Mi }
          volumeMounts:
            - { name: data, mountPath: /var/lib/postgresql/data }
            - { name: init, mountPath: /docker-entrypoint-initdb.d }
      volumes:
        - name: init
          configMap: { name: postgres-init }
  volumeClaimTemplates:
    - metadata: { name: data }
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: local-path
        resources: { requests: { storage: 5Gi } }
EOF

# 5.4 Application Microservices (pulling from Docker Hub)
cat <<EOF > "$MANIFESTS_DIR/04-urban-apps.yaml"
apiVersion: apps/v1
kind: Deployment
metadata:
  name: data-collector
  namespace: urban
spec:
  replicas: 1
  selector:
    matchLabels: { app: data-collector }
  template:
    metadata:
      labels: { app: data-collector }
    spec:
      securityContext: { runAsNonRoot: true, runAsUser: 10001 }
      containers:
        - name: data-collector
          image: "${docker_registry}/data-collector:${docker_tag}"
          imagePullPolicy: IfNotPresent
          ports: [{ name: http, containerPort: 8080 }]
          envFrom:
            - configMapRef: { name: urban-config }
            - secretRef: { name: collector-secret }
          resources:
            requests: { cpu: 50m, memory: 96Mi }
            limits: { cpu: 250m, memory: 256Mi }
          readinessProbe:
            httpGet: { path: /ready, port: http }
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: data-collector
  namespace: urban
  labels: { app: data-collector }
spec:
  ports: [{ name: http, port: 8080, targetPort: http }]
  selector: { app: data-collector }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: data-processor
  namespace: urban
spec:
  replicas: 1
  selector:
    matchLabels: { app: data-processor }
  template:
    metadata:
      labels: { app: data-processor }
    spec:
      securityContext: { runAsNonRoot: true, runAsUser: 10001 }
      containers:
        - name: data-processor
          image: "${docker_registry}/data-processor:${docker_tag}"
          imagePullPolicy: IfNotPresent
          ports: [{ name: http, containerPort: 5000 }]
          envFrom:
            - configMapRef: { name: urban-config }
            - secretRef: { name: db-credentials }
          resources:
            requests: { cpu: 100m, memory: 192Mi }
            limits: { cpu: 500m, memory: 512Mi }
          readinessProbe:
            httpGet: { path: /ready, port: http }
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: data-processor
  namespace: urban
  labels: { app: data-processor }
spec:
  ports: [{ name: http, port: 5000, targetPort: http }]
  selector: { app: data-processor }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: analytics-service
  namespace: urban
spec:
  replicas: 1
  selector:
    matchLabels: { app: analytics-service }
  template:
    metadata:
      labels: { app: analytics-service }
    spec:
      securityContext: { runAsNonRoot: true, runAsUser: 10001 }
      containers:
        - name: analytics-service
          image: "${docker_registry}/analytics-service:${docker_tag}"
          imagePullPolicy: IfNotPresent
          ports: [{ name: http, containerPort: 5001 }]
          envFrom:
            - configMapRef: { name: urban-config }
            - secretRef: { name: db-credentials }
          resources:
            requests: { cpu: 150m, memory: 384Mi }
            limits: { cpu: 800m, memory: 768Mi }
          readinessProbe:
            httpGet: { path: /ready, port: http }
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: analytics-service
  namespace: urban
  labels: { app: analytics-service }
spec:
  ports: [{ name: http, port: 5001, targetPort: http }]
  selector: { app: analytics-service }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api-service
  namespace: urban
spec:
  replicas: 1
  selector:
    matchLabels: { app: api-service }
  template:
    metadata:
      labels: { app: api-service }
    spec:
      securityContext: { runAsNonRoot: true, runAsUser: 1000 }
      containers:
        - name: api-service
          image: "${docker_registry}/api-service:${docker_tag}"
          imagePullPolicy: IfNotPresent
          ports: [{ name: http, containerPort: 3000 }]
          envFrom:
            - configMapRef: { name: urban-config }
            - secretRef: { name: db-credentials }
            - secretRef: { name: api-auth-secret }
          resources:
            requests: { cpu: 50m, memory: 96Mi }
            limits: { cpu: 300m, memory: 256Mi }
          readinessProbe:
            httpGet: { path: /health, port: http }
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: api-service
  namespace: urban
  labels: { app: api-service }
spec:
  ports: [{ name: http, port: 3000, targetPort: http }]
  selector: { app: api-service }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web-dashboard
  namespace: urban
spec:
  replicas: 1
  selector:
    matchLabels: { app: web-dashboard }
  template:
    metadata:
      labels: { app: web-dashboard }
    spec:
      containers:
        - name: web-dashboard
          image: "${docker_registry}/web-dashboard:${docker_tag}"
          imagePullPolicy: IfNotPresent
          ports: [{ name: http, containerPort: 80 }]
          resources:
            requests: { cpu: 25m, memory: 32Mi }
            limits: { cpu: 100m, memory: 96Mi }
          readinessProbe:
            httpGet: { path: /, port: http }
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: web-dashboard
  namespace: urban
  labels: { app: web-dashboard }
spec:
  ports: [{ name: http, port: 80, targetPort: http }]
  selector: { app: web-dashboard }
EOF

# 5.5 Ingress Resource routing traffic via nip.io
cat <<EOF > "$MANIFESTS_DIR/05-urban-ingress.yaml"
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: urban-ingress
  namespace: urban
  annotations:
    nginx.ingress.kubernetes.io/proxy-body-size: "1m"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "60"
spec:
  ingressClassName: nginx
  rules:
    - host: "app.${public_ip}.nip.io"
      http:
        paths:
          - path: /api
            pathType: Prefix
            backend:
              service:
                name: api-service
                port: { number: 3000 }
          - path: /
            pathType: Prefix
            backend:
              service:
                name: web-dashboard
                port: { number: 80 }
    - host: "api.${public_ip}.nip.io"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: api-service
                port: { number: 3000 }
EOF

# 5.6 ServiceMonitor for Prometheus scraping
cat <<'EOFSM' > "$MANIFESTS_DIR/06-servicemonitor.yaml"
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: urban-microservices
  namespace: urban
  labels:
    release: kps
spec:
  selector:
    matchExpressions:
      - key: app
        operator: In
        values: ["analytics-service", "api-service", "data-collector", "data-processor"]
  endpoints:
    - port: http
      path: /metrics
      interval: 15s
EOFSM

# 5.7 Pre-provisioned Grafana Urban Health Dashboard JSON
cat <<'EOFDASH' > /etc/urban/urban-health.json
${grafana_dashboard_json}
EOFDASH


# 6. Install Helm 3 on host
curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash

# 7. Pre-build Microservice Docker Images and Import into K3s containerd
git clone https://github.com/Akash123-cyber/Urban-Environmental-Intelligence-Prediction-Platform.git /tmp/urban-repo || true
if [ -d /tmp/urban-repo/services ]; then
  for svc in data-collector data-processor analytics-service api-service web-dashboard; do
    echo "Building Docker image for $svc..."
    docker build -t ${docker_registry}/$svc:${docker_tag} /tmp/urban-repo/services/$svc || true
  done
  rm -rf /tmp/urban-repo
fi
docker image prune -f || true
apt-get clean || true
rm -rf /var/lib/apt/lists/* || true

# 8. Deploy Prometheus & Grafana Observability Stack
helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
helm repo update

kubectl create namespace monitoring || true
kubectl -n monitoring create secret generic grafana-admin \
  --from-literal=admin-user=admin \
  --from-literal=admin-password='UrbanEnvGrafana2026!#' \
  --dry-run=client -o yaml | kubectl apply -f -

cat <<'EOFVAL' > /var/lib/kube-prometheus-stack-values.yaml
fullnameOverride: kps

defaultRules:
  create: true
  rules:
    etcd: false
    kubeControllerManager: false
    kubeSchedulerAlerting: false
    kubeProxy: false

kubeEtcd: { enabled: false }
kubeControllerManager: { enabled: false }
kubeScheduler: { enabled: false }
kubeProxy: { enabled: false }

prometheus:
  prometheusSpec:
    retention: 2d
    retentionSize: 1.5GB
    scrapeInterval: 30s
    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
    ruleSelectorNilUsesHelmValues: false
    resources:
      requests: { cpu: 30m, memory: 160Mi }
      limits: { memory: 400Mi }
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: local-path
          accessModes: ["ReadWriteOnce"]
          resources: { requests: { storage: 1.5Gi } }

alertmanager:
  alertmanagerSpec:
    resources:
      requests: { cpu: 10m, memory: 32Mi }
      limits: { memory: 96Mi }

grafana:
  adminUser: admin
  admin:
    existingSecret: grafana-admin
    userKey: admin-user
    passwordKey: admin-password
  ingress:
    enabled: true
    ingressClassName: nginx
    hosts:
      - grafana.${public_ip}.nip.io
  resources:
    requests: { cpu: 80m, memory: 192Mi }
    limits: { memory: 512Mi }
  readinessProbe:
    httpGet:
      path: /api/health
      port: 3000
    initialDelaySeconds: 15
    timeoutSeconds: 5
    periodSeconds: 10
    failureThreshold: 5
  livenessProbe:
    httpGet:
      path: /api/health
      port: 3000
    initialDelaySeconds: 30
    timeoutSeconds: 5
    periodSeconds: 10
    failureThreshold: 5
  sidecar:
    dashboards:
      enabled: true
      label: grafana_dashboard
      searchNamespace: ALL
  persistence: { enabled: false }

kube-state-metrics:
  resources: { requests: { cpu: 10m, memory: 32Mi }, limits: { memory: 96Mi } }

prometheus-node-exporter:
  resources: { requests: { cpu: 10m, memory: 16Mi }, limits: { memory: 48Mi } }

prometheusOperator:
  resources: { requests: { cpu: 15m, memory: 48Mi }, limits: { memory: 160Mi } }
EOFVAL

# Wait for ingress-nginx controller before deploying helm chart
until kubectl -n ingress-nginx get pods -l app.kubernetes.io/component=controller 2>/dev/null | grep -q "Running"; do
  sleep 5
done

helm upgrade --install kps prometheus-community/kube-prometheus-stack \
  -n monitoring \
  -f /var/lib/kube-prometheus-stack-values.yaml \
  --timeout 10m || true

# Apply urban-health dashboard to Grafana via ConfigMap
if [ -f /etc/urban/urban-health.json ]; then
  kubectl create configmap urban-health-dashboard -n monitoring --from-file=urban-health.json=/etc/urban/urban-health.json -o yaml --dry-run=client | kubectl apply -f -
  kubectl label configmap urban-health-dashboard -n monitoring grafana_dashboard="1" --overwrite || true
fi


# 9. Bootstrap Jenkins CI/CD Controller on port 8080
mkdir -p /var/jenkins_home/.kube
chown -R 1000:1000 /var/jenkins_home
chmod 666 /var/run/docker.sock

# Copy K3s kubeconfig for Jenkins master and configure private IP
cp /etc/rancher/k3s/k3s.yaml /var/jenkins_home/.kube/config
sed -i "s|127.0.0.1:6443|$PRIV_IP:6443|g" /var/jenkins_home/.kube/config
chown -R 1000:1000 /var/jenkins_home/.kube
chmod 600 /var/jenkins_home/.kube/config

# Ensure Docker socket permissions persist across daemon restarts and boots
mkdir -p /etc/systemd/system/docker.service.d
cat <<EOF > /etc/systemd/system/docker.service.d/override.conf
[Service]
ExecStartPost=/bin/chmod 666 /var/run/docker.sock
EOF

# Ensure K3s reliably orders after Docker on system boot
mkdir -p /etc/systemd/system/k3s.service.d
cat <<EOF > /etc/systemd/system/k3s.service.d/override.conf
[Unit]
Wants=docker.service
After=docker.service
Requires=docker.service
EOF
systemctl daemon-reload
chmod 666 /var/run/docker.sock 2>/dev/null || true

# Run Jenkins container with memory limits optimized for t3.medium
docker run -d --name jenkins --restart unless-stopped \
  -p 8080:8080 -p 50000:50000 \
  -v /var/jenkins_home:/var/jenkins_home \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -e JAVA_OPTS="-Djenkins.install.runSetupWizard=false -Xms256m -Xmx512m" \
  jenkins/jenkins:lts-jdk21

# Wait for Jenkins container to start
sleep 15
until docker exec jenkins test -f /var/jenkins_home/war/WEB-INF/lib/jenkins-core-*.jar 2>/dev/null || docker exec jenkins curl -sf http://localhost:8080/ >/dev/null 2>&1; do
  sleep 5
done

# Install Jenkins Toolchain inside container
docker exec -u 0 jenkins bash -c "
  apt-get update && apt-get install -y curl ca-certificates git python3 python3-pip python3-venv
  curl -fsSL https://get.docker.com -o get-docker.sh && sh get-docker.sh && usermod -aG docker jenkins || true
  curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && apt-get install -y nodejs || true
  curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash || true
  curl -LO \"https://dl.k8s.io/release/\$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl\"
  chmod +x kubectl && mv kubectl /usr/local/bin/
  apt-get clean && rm -rf /var/lib/apt/lists/*
" || true

# Install Jenkins Essential Plugins
docker exec -u 0 jenkins jenkins-plugin-cli --plugins git github workflow-aggregator pipeline-stage-view ws-cleanup || true

# Configure Admin credentials in Jenkins Groovy initialization
mkdir -p /var/jenkins_home/init.groovy.d
cat <<'EOFG' > /var/jenkins_home/init.groovy.d/basic-security.groovy
#!groovy
import jenkins.model.*
import hudson.security.*

def instance = Jenkins.getInstance()
def hudsonRealm = new HudsonPrivateSecurityRealm(false)
hudsonRealm.createAccount("admin", "53745d3c15584eccb436467585cfde9d")
instance.setSecurityRealm(hudsonRealm)

def strategy = new FullControlOnceLoggedInAuthorizationStrategy()
strategy.setAllowAnonymousRead(false)
instance.setAuthorizationStrategy(strategy)
instance.save()
EOFG
# Create UrbanEIIP-Pipeline job directly in Jenkins home directory
mkdir -p /var/jenkins_home/jobs/UrbanEIIP-Pipeline
cat <<'EOFJOB' > /var/jenkins_home/jobs/UrbanEIIP-Pipeline/config.xml
<?xml version='1.1' encoding='UTF-8'?>
<flow-definition plugin="workflow-job">
  <actions/>
  <description>Automated CI/CD Pipeline for Urban Environmental Intelligence &amp; Prediction Platform</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <com.coravy.hudson.plugins.github.GithubProjectProperty plugin="github">
      <projectUrl>https://github.com/Akash123-cyber/Urban-Environmental-Intelligence-Prediction-Platform.git/</projectUrl>
      <displayName>UrbanEIIP</displayName>
    </com.coravy.hudson.plugins.github.GithubProjectProperty>
    <org.jenkinsci.plugins.workflow.job.properties.PipelineTriggersJobProperty>
      <triggers>
        <com.cloudbees.jenkins.GitHubPushTrigger plugin="github">
          <spec></spec>
        </com.cloudbees.jenkins.GitHubPushTrigger>
      </triggers>
    </org.jenkinsci.plugins.workflow.job.properties.PipelineTriggersJobProperty>
  </properties>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps">
    <scm class="hudson.plugins.git.GitSCM" plugin="git">
      <configVersion>2</configVersion>
      <userRemoteConfigs>
        <hudson.plugins.git.UserRemoteConfig>
          <url>https://github.com/Akash123-cyber/Urban-Environmental-Intelligence-Prediction-Platform.git</url>
        </hudson.plugins.git.UserRemoteConfig>
      </userRemoteConfigs>
      <branches>
        <hudson.plugins.git.BranchSpec>
          <name>*/main</name>
        </hudson.plugins.git.BranchSpec>
      </branches>
      <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
      <submoduleCfg class="empty-list"/>
      <extensions/>
    </scm>
    <scriptPath>Jenkinsfile</scriptPath>
    <lightweight>true</lightweight>
  </definition>
  <triggers/>
  <disabled>false</disabled>
</flow-definition>
EOFJOB
chown -R 1000:1000 /var/jenkins_home/jobs

# Restart Jenkins to load plugins, security config, and pipeline job
docker restart jenkins

# Wait for Jenkins to come back up
sleep 20
until curl -sf -u admin:53745d3c15584eccb436467585cfde9d http://localhost:8080/api/json >/dev/null 2>&1; do
  sleep 5
done

# Trigger initial build of pipeline job so the platform builds & deploys immediately
rm -f /tmp/jk_cookies
CRUMB=$(curl -s -c /tmp/jk_cookies -u admin:53745d3c15584eccb436467585cfde9d http://localhost:8080/crumbIssuer/api/json 2>/dev/null | grep -o '"crumb":"[^"]*"' | cut -d'"' -f4 || true)
if [ -n "$CRUMB" ]; then
  curl -sf -b /tmp/jk_cookies -u admin:53745d3c15584eccb436467585cfde9d -H "Jenkins-Crumb: $CRUMB" -X POST http://localhost:8080/job/UrbanEIIP-Pipeline/build || true
else
  curl -sf -u admin:53745d3c15584eccb436467585cfde9d -X POST http://localhost:8080/job/UrbanEIIP-Pipeline/build || true
fi


# 10. Automated Seeding of 96h Historical Observations, 24h Predictions & Alerts
echo "Waiting for postgres and data-processor to be ready for seeding..."
until kubectl -n urban get pod postgres-0 2>/dev/null | grep -q "1/1.*Running"; do
  sleep 5
done
until kubectl -n urban get deployment data-processor 2>/dev/null | grep -q "1/1"; do
  sleep 5
done

cat <<'EOFSEED' > /tmp/seed_all_cities.py
import math, random, os
from datetime import datetime, timedelta, timezone
import psycopg2

def seed_all_cities():
    db_url = os.getenv("DATABASE_URL", "postgresql://urban:${postgres_password}@postgres:5432/urban")
    conn = psycopg2.connect(db_url)
    conn.autocommit = True
    cur = conn.cursor()

    cur.execute("SELECT id, name, slug FROM cities ORDER BY id;")
    cities = cur.fetchall()
    now = datetime.now(timezone.utc).replace(minute=0, second=0, microsecond=0)

    profiles = {
        1:  {"name": "Delhi",      "pm25": 170, "pm10": 190, "temp": 27, "hum": 48, "wind": 1.6},
        2:  {"name": "Mumbai",     "pm25": 74,  "pm10": 86,  "temp": 30, "hum": 62, "wind": 3.0},
        3:  {"name": "Kolkata",    "pm25": 75,  "pm10": 76,  "temp": 28, "hum": 70, "wind": 2.5},
        4:  {"name": "Chennai",    "pm25": 20,  "pm10": 24,  "temp": 30, "hum": 74, "wind": 4.2},
        5:  {"name": "Bengaluru",  "pm25": 22,  "pm10": 25,  "temp": 22, "hum": 65, "wind": 3.5},
    }

    cur.execute("DELETE FROM predictions;")
    cur.execute("DELETE FROM weather_data;")
    cur.execute("DELETE FROM air_quality_data;")
    cur.execute("DELETE FROM alerts;")

    for city_id, name, slug in cities:
        prof = profiles.get(city_id, {"pm25": 100, "pm10": 160, "temp": 26, "hum": 60, "wind": 3.0})
        for h in range(96, -1, -1):
            t = now - timedelta(hours=h)
            hour_of_day = t.hour
            diurnal = 1.0 + 0.25 * math.sin((hour_of_day - 6) * math.pi / 12)
            noise = random.uniform(-8.0, 8.0)
            is_anomaly = (h == 14 and city_id in [1]) or (h == 28 and city_id == 2)
            anomaly_mult = 1.55 if is_anomaly else 1.0

            pm25 = round(max(15.0, (prof["pm25"] * diurnal + noise) * anomaly_mult), 1)
            pm10 = round(max(30.0, (prof["pm10"] * diurnal + noise * 1.4) * anomaly_mult), 1)
            no2 = round(max(10.0, 35.0 + 15.0 * diurnal + random.uniform(-4, 4)), 1)
            o3 = round(max(5.0, 25.0 + 10.0 * math.sin(hour_of_day * math.pi / 12) + random.uniform(-3, 3)), 1)
            co = round(max(0.2, 1.2 * diurnal + random.uniform(-0.1, 0.2)), 2)
            so2 = round(max(2.0, 12.0 + random.uniform(-2, 3)), 1)

            if pm25 <= 30: aqi = int(pm25 * 50 / 30)
            elif pm25 <= 60: aqi = int(50 + (pm25 - 30) * 50 / 30)
            elif pm25 <= 90: aqi = int(100 + (pm25 - 60) * 100 / 30)
            elif pm25 <= 120: aqi = int(200 + (pm25 - 90) * 100 / 30)
            elif pm25 <= 250: aqi = int(300 + (pm25 - 120) * 100 / 130)
            else: aqi = int(400 + (pm25 - 250) * 100 / 100)
            aqi = min(500, aqi)

            cur.execute("""
                INSERT INTO air_quality_data 
                (city_id, observed_at, pm25, pm10, no2, o3, co, so2, aqi, is_anomaly, source)
                VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s);
            """, (city_id, t, pm25, pm10, no2, o3, co, so2, aqi, is_anomaly, "cpcb_telemetry"))

            temp = round(prof["temp"] + 5.0 * math.sin((hour_of_day - 9) * math.pi / 12) + random.uniform(-1, 1), 1)
            hum = round(max(20.0, min(95.0, prof["hum"] - 10.0 * math.sin((hour_of_day - 9) * math.pi / 12) + random.uniform(-2, 2))), 1)
            wind = round(max(0.5, prof["wind"] + random.uniform(-0.8, 0.8)), 1)

            cur.execute("""
                INSERT INTO weather_data 
                (city_id, observed_at, temperature, humidity, wind_speed)
                VALUES (%s, %s, %s, %s, %s);
            """, (city_id, t, temp, hum, wind))

    for city_id, name, slug in cities:
        prof = profiles.get(city_id, {"pm25": 100, "pm10": 160})
        for h in range(1, 25):
            target_t = now + timedelta(hours=h)
            hour_of_day = target_t.hour
            diurnal = 1.0 + 0.22 * math.sin((hour_of_day - 6) * math.pi / 12)
            noise = random.uniform(-5.0, 5.0)
            pred_pm25 = round(max(15.0, prof["pm25"] * diurnal + noise), 1)
            pred_pm10 = round(max(30.0, prof["pm10"] * diurnal + noise * 1.3), 1)
            cur.execute("""
                INSERT INTO predictions 
                (city_id, generated_at, target_time, predicted_pm25, predicted_pm10, model_version, based_on)
                VALUES (%s, %s, %s, %s, %s, %s, %s);
            """, (city_id, now, target_t, pred_pm25, pred_pm10, "lightgbm_v1.0.0", now))

    active_alerts = [
        (1, 'critical', 'high_aqi', 'Severe AQI Alert: PM2.5 reached 242.0 µg/m³ under calm boundary conditions. Sensitive groups advised to stay indoors.'),
        (1, 'warning', 'inversion', 'Thermal Inversion Warning: Rapid surface radiative cooling detected with 1.1 m/s wind velocity; dispersion capacity restricted.'),
        (1, 'critical', 'high_aqi', 'PM2.5 spike (268.4 µg/m³) exceeded Severe regulatory threshold. Automated mitigation and GRAP Stage-IV advisory active.'),
        (2, 'warning', 'anomaly', 'Relative humidity drop combined with low wind velocity detected. Atmospheric dispersion index diminished.'),
        (3, 'warning', 'industrial_emission', 'Industrial boundary corridor elevation: Elevated NO2 and particulate accumulation near eastern ring road.'),
        (4, 'warning', 'dust_storm', 'Elevated particulate flux detected along the coastal corridor due to onshore wind shear.'),
        (5, 'info', 'sensor_anomaly', 'Sensor Node BLR-08 self-check passed: Automated recalibration completed after transient spike.'),
    ]
    for city_id, severity, alert_type, message in active_alerts:
        created_time = now - timedelta(minutes=random.randint(15, 180))
        cur.execute("""
            INSERT INTO alerts (city_id, severity, type, message, created_at, resolved_at)
            VALUES (%s, %s, %s, %s, %s, NULL);
        """, (city_id, severity, alert_type, message, created_time))

    conn.close()
    print("Database seeding completed.")

if __name__ == "__main__":
    seed_all_cities()
EOFSEED

DP_POD=$(kubectl -n urban get pods -l app=data-processor -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)
if [ -n "$DP_POD" ]; then
  kubectl -n urban cp /tmp/seed_all_cities.py "$DP_POD":/tmp/seed_all_cities.py || true
  kubectl -n urban exec deploy/data-processor -- python /tmp/seed_all_cities.py || true
fi

echo "bootstrap complete" > /var/log/bootstrap-done
