# --- Database ---
POSTGRES_USER=urban
POSTGRES_PASSWORD=urban_dev_password
POSTGRES_DB=urban
DATABASE_URL=postgresql://urban:urban_dev_password@postgres:5432/urban

# --- Service Wiring ---
PROCESSOR_URL=http://data-processor:5000
ANALYTICS_URL=http://analytics-service:5001
POLL_INTERVAL_SECONDS=900
ANALYTICS_INTERVAL_SECONDS=1800
LIVE_LOOKBACK_HOURS=2
USE_PRETRAINED=true
LOG_LEVEL=INFO

# --- Object Storage (MinIO local / S3 AWS) ---
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
S3_RAW_BUCKET=urban-raw
S3_PROCESSED_BUCKET=urban-processed
S3_MODEL_BUCKET=urban-models
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- API Gateway & Auth ---
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassword123!

# --- Data Sources (Optional) ---
OPENAQ_API_KEY=
