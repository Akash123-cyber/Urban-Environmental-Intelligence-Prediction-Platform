# ==============================================================================
# Urban Environmental Intelligence & Prediction Platform (UrbanEIIP)
# Environment Configuration Template
# ==============================================================================

# --- Database (PostgreSQL) ---
POSTGRES_USER=urban
POSTGRES_PASSWORD=urban_dev_password
POSTGRES_DB=urban
DATABASE_URL=postgresql://urban:urban_dev_password@postgres:5432/urban

# --- Internal Service Endpoints & Orchestration ---
PROCESSOR_URL=http://data-processor:5000
ANALYTICS_URL=http://analytics-service:5001
API_URL=http://api-service:3000
POLL_INTERVAL_SECONDS=900
ANALYTICS_INTERVAL_SECONDS=1800
LIVE_LOOKBACK_HOURS=2
USE_PRETRAINED=true
LOG_LEVEL=INFO

# --- Regional Meteorological Fallback ---
# Enables cross-regional meteorology mapping (e.g. Pune/Ahmedabad -> Mumbai, Lucknow/Jaipur -> Delhi)
ENABLE_METEO_FALLBACK=true

# --- S3 Object Storage (MinIO Local / AWS S3 Cloud) ---
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
S3_RAW_BUCKET=urban-raw
S3_PROCESSED_BUCKET=urban-processed
S3_MODEL_BUCKET=urban-models
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- API Gateway, Security & Authentication ---
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassword123!
PORT=3000

# --- Telemetry Sources ---
OPENAQ_API_KEY=
CPCB_API_ENDPOINT=https://api.openaq.org/v3

# --- CI/CD & Deployment ---
DOCKER_REGISTRY=docker.io/akash123cyber
IMAGE_TAG=latest
